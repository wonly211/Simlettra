{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "tests/**/*.ts",
    "src/web/mail-auto-refresh.ts",
    "src/worker/**/*.ts",
    "src/modules/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
